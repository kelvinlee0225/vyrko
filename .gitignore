# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editors/IDEs
.vscode/
.idea/
*.swp
*.swo

# Claude Code personal tooling (local settings, installed plugins/skills)
.claude/

# Env files at the repo root (backend/ and frontend/ already ignore their own)
.env
.env.local
.env.*.local
!.env.example

# DGII signing certificates and private keys — must never be committed.
# The backend reads these from DGII_CERT_PATH/DGII_CERT_PASSWORD at runtime,
# not from the repo — see docs/AWS_DEPLOYMENT.md.
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
certs/

# graphify — regenerable extraction cache and dated backup snapshots
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
